rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.get('email', '') == "alhabsyiadit@gmail.com"
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') == "alhabsyiadit@gmail.com" || 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'operator') == 'super_admin')
      );
    }

    match /config/settings {
      allow read: if true; 
      allow write: if isSuperAdmin();
    }

    match /counters/{counterId} {
      allow read, write: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && request.auth.uid == userId; 
      allow update, delete: if isSuperAdmin();
    }

    match /invitations/{inviteId} {
      allow read: if isSignedIn();
      // Allow users to delete their own invitations when claiming them
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        resource.data.get('email', '') == request.auth.token.get('email', '') ||
        resource.data.get('phoneNumber', '') == request.auth.token.get('phone_number', '')
      );
      allow create, update: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if isAdmin();
      allow list: if isSuperAdmin();
      allow delete: if isSuperAdmin();
      allow get, update: if false;
    }
  }
}
