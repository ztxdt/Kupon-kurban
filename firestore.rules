rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let userEmail = request.auth.token.email;
      return isSignedIn() && (
        userEmail == "alhabsyiadit@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isSuperAdmin() {
      let userEmail = request.auth.token.email;
      return isSignedIn() && (
        userEmail == "alhabsyiadit@gmail.com" || 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    match /config/settings {
      allow read: if true; 
      allow write: if isSuperAdmin();
    }

    match /counters/{counterId} {
      allow read: if true;
      allow create: if isAdmin() || (counterId == "coupons" && request.resource.data.count == 1);
      allow update: if isAdmin() || (
        counterId == "coupons" && 
        request.resource.data.count == resource.data.count + 1
      );
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() || (
          request.resource.data.queueNumber == getAfter(/databases/$(database)/documents/counters/coupons).data.count &&
          request.resource.data.status == "pending" &&
          request.resource.data.createdAt == request.time
        )
      );
        
      allow update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /admins/{userId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn() && request.auth.uid == userId; 
      allow update, delete: if isSuperAdmin();
    }

    match /invitations/{inviteId} {
      allow read: if isSignedIn();
      // Allow users to delete their own invitations when claiming them
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        resource.data.get('email', '') == request.auth.token.get('email', '') ||
        resource.data.get('phoneNumber', '') == request.auth.token.get('phone_number', '')
      );
      allow create, update: if isSuperAdmin();
    }

    match /audit_logs/{logId} {
      allow create: if isAdmin();
      allow list: if isSuperAdmin();
      allow delete: if isSuperAdmin();
      allow get, update: if false;
    }

    match /registrations_by_phone/{phone} {
      allow read: if true;
      allow create: if true; // Validation happens in coupons create
      allow update, delete: if isAdmin();
    }
  }
}
